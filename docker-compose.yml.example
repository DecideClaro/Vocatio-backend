services:
  server:
    image: vocatio:latest
    build:
      context: .
      dockerfile: Dockerfile
    restart: always

    environment:
      # PORT: 8080
      # ENV: "local"
      # SPRING_DATASOURCE_URL: ${SPRING_DATASOURCE_URL}
      # SPRING_DATASOURCE_USERNAME: ${SPRING_DATASOURCE_USERNAME}
      # SPRING_DATASOURCE_PASSWORD: ${SPRING_DATASOURCE_PASSWORD}

      #JWT_SECRET: ${JWT_SECRET}

      #PORT: 8080
      #ENV: "local"

      SPRING_DATASOURCE_URL: YOUR_URL_HERE
      SPRING_DATASOURCE_USERNAME: postgresadmin
      SPRING_DATASOURCE_PASSWORD: YOUR_PASSWORD_HERE

      #JWT_SECRET: ${JWT_SECRET}   
      JWT_SECRET: YOUR_JWT_SECRET_HERE
      DEEPSEEK_API_KEY: YOUR_DEEPSEEK_API_KEY_HERE

    ports:
      - "8080:8080"

  postgres:
    image: postgres:16
    container_name: postgres_vocatio
    restart: always
    environment:
      POSTGRES_DB: vocatio_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: password
    ports:
      - "5434:5432" # HOST:CONTENEDOR  34
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U postgres -d vocatio_db" ]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - postgres_data:/var/lib/postgresql/data
volumes:
  postgres_data:


